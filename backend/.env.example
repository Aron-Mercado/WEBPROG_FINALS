# Copy to backend/.env and fill in your local values. Never commit .env to Git.
# database.php reads these keys via env() — passwords stay out of PHP source files.

DB_HOST=localhost
DB_NAME=food_delivery
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# true = show PHP errors locally; false before sharing / production
APP_DEBUG=true

# Your Vite dev server URL (not a secret, but keep out of source code)
CORS_ORIGIN=
