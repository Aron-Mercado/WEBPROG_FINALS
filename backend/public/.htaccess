# backend/public/.htaccess
# Only folder under backend/ that should accept HTTP requests (overrides parent deny rules).

Order deny,allow
# Allow from all — to keep the API entry open while other folders are denied.
Allow from all

Options -Indexes
RewriteEngine On

# Pass Authorization header through to PHP (required for Bearer login on XAMPP/Apache)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]
